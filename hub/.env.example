# Server listener settings
PORT=4318
HOST=0.0.0.0

# SQLite storage path (defaults to /data/skanvil-hub.sqlite in Docker)
SKANVIL_HUB_DB_PATH=./data/skanvil-hub.sqlite

# Optional PostgreSQL connection URL (switches storage from SQLite to PostgreSQL)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/skanvil_hub

# Optional comma-separated Bearer API keys required on POST /v1/events
# Leave blank for open ingestion on trusted private networks
SKANVIL_HUB_API_KEYS=replace-with-ingest-key-1,replace-with-ingest-key-2

# Optional admin token protecting the dashboard UI and /api/dashboard/*
# Leave blank only for local single-user development
SKANVIL_HUB_ADMIN_TOKEN=replace-with-strong-admin-token

# Set to true when serving behind an HTTPS reverse proxy
SKANVIL_HUB_COOKIE_SECURE=false

# Optional automatic data retention in days (keeps latest library snapshot per library)
# SKANVIL_HUB_RETENTION_DAYS=90

# Optional webhook URL (Slack, Discord, Teams, or custom JSON receiver) and alert thresholds
# SKANVIL_HUB_WEBHOOK_URL=https://hooks.slack.com/services/...
# SKANVIL_HUB_ALERT_MAX_STAGE1_TOKENS=3000
# SKANVIL_HUB_ALERT_MIN_EVAL_PASS_RATE=0.85
# SKANVIL_HUB_ALERT_ON_VALIDATION_ERRORS=true
# SKANVIL_HUB_ALERT_ON_DEPRECATED_SYNC=true
